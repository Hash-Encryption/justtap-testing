{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "strictNullChecks": true,
    "plugins": [],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist", ".output", "src/**/*.test.ts", "src/**/*.test-fixture.ts"]
}
